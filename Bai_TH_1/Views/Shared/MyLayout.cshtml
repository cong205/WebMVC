<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bai_TH_1</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Bai_TH_1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @await Html.PartialAsync("TopNav")
    </header>

    <div class="container-fluid">
        <div class="row">
            <!-- LEFT MENU -->
            <div class="col-md-3 col-lg-2 bg-light border-end">
                @await Html.PartialAsync("LeftMenu")
            </div>

            <!-- MAIN CONTENT -->
            <div class="col-md-9 col-lg-10 py-3">
                <main role="main" class="pb-3" id="content">
                    @RenderBody()
                </main>
            </div>
        </div>

        <!-- PAGINATION UI -->
        <ul class="pagination mt-3">
            @for (int i = 1; i <= (ViewBag.pageNum ?? 1); i++)
            {
                <li class="page-item @(i == (ViewBag.currentPage ?? 1) ? "active" : "")"
                    data-page="@i"
                    data-mid="@ViewBag.mid"
                    data-keyword="@ViewBag.keyword">
                    <a class="page-link" href="#">@i</a>
                </li>
            }
        </ul>
    </div>

    <footer class="border-top footer text-muted mt-3">
        @await Html.PartialAsync("Footer")
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Scripts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @section Scripts{
        <script>
                        $('body').on('click', 'li.page-item', function () {
                var page = $(this).data("page");
                var keyword = $("#keyword").val();

                $.ajax({
                    url: "/Student/Index",
                    type: "GET",
                    data: { page: page, keyword: keyword },
                    success: function (response) {
                        $("#content").html($(response).find("#content").html());
                        $("ul.pagination").html($(response).find("ul.pagination").html());
                    }
                });
            });

            $("#btnSearch").click(function () {
                var keyword = $("#keyword").val();
                $.ajax({
                    url: "/Student/Index",
                    type: "GET",
                    data: { keyword: keyword, page: 1 },
                    success: function (response) {
                        $("#content").html($(response).find("#content").html());
                        $("ul.pagination").html($(response).find("ul.pagination").html());
                    }
                });
            });
        </script>
    }
</body>
</html>
