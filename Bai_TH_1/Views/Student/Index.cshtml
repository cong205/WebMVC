@model IEnumerable<Student>

<a asp-action="Create" class="btn btn-primary">Create Student </a>

<form method="get" asp-action="Index" class="mt-3 mb-3">
    <input type="text" name="keyword" value="@ViewBag.keyword" placeholder="Search..." class="form-control" />
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBorth</td>

                @{
                    string str = s.Branch switch
                    {
                        Branch.IT => "CNTT",
                        Branch.BE => "Kinh tế",
                        Branch.CE => "Công trình",
                        Branch.EE => "Điện - Điện tử",
                        _ => ""
                    };
                }

                <td>@str</td>
                <td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
            </tr>
        }
    </tbody>
</table>

<ul class="pagination mt-3">
    @for (int i = 1; i <= (ViewBag.pageNum ?? 1); i++)
    {
        <li class="page-item @(i == (ViewBag.currentPage ?? 1) ? "active" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-keyword="@ViewBag.keyword">@i</a>
        </li>
    }
</ul>
