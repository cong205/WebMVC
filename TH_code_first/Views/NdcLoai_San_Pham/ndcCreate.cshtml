@model TH_code_first.Models.NdcLoai_San_Pham

@{
    ViewData["Title"] = "Create";
}

<h1>Thêm loại sản phẩm</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="ndcCreate" asp-controller="NdcLoai_San_Pham" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ndcMaLoai" class="control-label"></label>
                <input asp-for="ndcMaLoai" class="form-control" />
                <span asp-validation-for="ndcMaLoai" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ndcTenLoai" class="control-label"></label>
                <input asp-for="ndcTenLoai" class="form-control" />
                <span asp-validation-for="ndcTenLoai" class="text-danger"></span>
            </div>

            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="ndcTrangThai" /> @Html.DisplayNameFor(model => model.ndcTrangThai)
                </label>
            </div>

            <button type="submit" class="btn btn-primary">Ghi lại</button>
            <a asp-action="ndcIndex" class="btn btn-secondary ms-2">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
