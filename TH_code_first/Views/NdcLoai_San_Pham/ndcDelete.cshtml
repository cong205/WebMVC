@model TH_code_first.Models.NdcLoai_San_Pham

@{
    ViewData["Title"] = "Xóa loại sản phẩm";
}

<h2>Bạn có chắc chắn muốn xóa loại sản phẩm này?</h2>
<hr />

<dl class="row">
    <dt class="col-sm-2">Mã loại</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.ndcMaLoai)</dd>

    <dt class="col-sm-2">Tên loại</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.ndcTenLoai)</dd>

    <dt class="col-sm-2">Trạng thái</dt>
    <dd class="col-sm-10">
        @(Model.ndcTrangThai ? "Hoạt động" : "Ngừng hoạt động")
    </dd>
</dl>

<form asp-action="ndcDelete" method="post">
    <input type="hidden" asp-for="ndcID" />
    <button type="submit" class="btn btn-danger">Xóa</button>
    <a asp-action="ndcIndex" class="btn btn-secondary">Hủy</a>
</form>
