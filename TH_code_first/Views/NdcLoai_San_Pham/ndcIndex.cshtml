@model IEnumerable<TH_code_first.Models.NdcLoai_San_Pham>

@{
    ViewData["Title"] = "Danh sách loại sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-tags"></i> Danh sách loại sản phẩm
        </h2>
        <a asp-action="ndcCreate" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm mới
        </a>
    </div>

    @if (Model.Any())
    {
        <table class="table table-bordered table-hover shadow-sm align-middle text-center">
            <thead class="table-primary">
                <tr>
                    <th>Mã loại</th>
                    <th>Tên loại</th>
                    <th>Trạng thái</th>
                    <th style="width: 180px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ndcMaLoai</td>
                        <td>@item.ndcTenLoai</td>
                        <td>
                            @if (item.ndcTrangThai)
                            {
                                <span class="badge bg-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Ngừng hoạt động</span>
                            }
                        </td>
                        <td>
                            <a asp-action="ndcEdit" asp-route-id="@item.ndcID" class="btn btn-sm btn-warning me-1">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <a asp-action="ndcDetails" asp-route-id="@item.ndcID" class="btn btn-sm btn-info me-1 text-white">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                            <a asp-action="ndcDelete" asp-route-id="@item.ndcID" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-warning text-center shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> Không có dữ liệu loại sản phẩm nào.
        </div>
    }
</div>

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
}
