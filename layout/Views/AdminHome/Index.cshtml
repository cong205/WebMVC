@{
    Layout = "_LayoutAdmin";
}

<section class="content">
    <div class="container-fluid">
        <h1 class="mb-4">Bảng điều khiển</h1>

        <!-- Dashboard Summary -->
        <div class="row mb-4">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>120</h3>
                        <p>Truyện</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-book"></i>
                    </div>
                    <a href="/AdminComic" class="small-box-footer">Xem chi tiết <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>540</h3>
                        <p>Chương</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <a href="/AdminChapter" class="small-box-footer">Xem chi tiết <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
        </div>

        <!-- Comic Covers -->
        <h2 class="mb-3">Một số truyện nổi bật</h2>
        <div class="row">
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card shadow-sm">
                    <img src="~/images/comics/onepiece.jpg" class="card-img-top" alt="One Piece">
                    <div class="card-body text-center">
                        <h5 class="card-title">One Piece</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card shadow-sm">
                    <img src="~/images/comics/naruto.jpg" class="card-img-top" alt="Naruto">
                    <div class="card-body text-center">
                        <h5 class="card-title">Naruto</h5>
                    </div>
                </div>
            </div>

            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card shadow-sm">
                    <img src="~/images/comics/conan.jpg" class="card-img-top" alt="Detective Conan">
                    <div class="card-body text-center">
                        <h5 class="card-title">Detective Conan</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
