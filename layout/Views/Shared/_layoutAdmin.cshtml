@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản trị - Website Đọc Truyện</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />

    <!-- AdminLTE -->
    <link rel="stylesheet" href="~/lib/admin-lte/css/adminlte.min.css" />

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback" />
</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">

        <!-- Navbar -->
        @await Html.PartialAsync("_AdminNavbar")

        <!-- Sidebar -->
        @await Html.PartialAsync("_AdminSidebar")

        <!-- Content Wrapper -->
        <div class="content-wrapper p-3">
            @RenderBody()
        </div>

        <!-- Footer -->
        @await Html.PartialAsync("_AdminFooter")
    </div>

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Bootstrap Bundle -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/lib/admin-lte/js/adminlte.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
